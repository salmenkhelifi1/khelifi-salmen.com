# Contact form (POST /api/contact) — set in Netlify > Site settings > Environment variables.
# Never commit real values.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "Portfolio <contact@khelifi-salmen.com>"
CONTACT_FROM_EMAIL=
# Where enquiries are delivered. Defaults to hello@khelifi-salmen.com.
CONTACT_TO_EMAIL=
# Optional: analytics
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
# PostHog (client conversion analytics). Token is public by design (ships in
# client JS) — manage via env, never hardcode. Get from PostHog project settings.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
# First-party proxy path (matches next.config rewrites + netlify.toml). Override
# only if using a managed proxy subdomain or EU region.
# NEXT_PUBLIC_POSTHOG_HOST=/ingest
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# Set true to force capture on localhost/preview (default opts out).
# NEXT_PUBLIC_POSTHOG_ENABLED=
# PostHog error-tracking source maps (server build-time only, never NEXT_PUBLIC_).
# Requires a personal key with error-tracking write scope + Salmen approval.
# POSTHOG_API_KEY=
# POSTHOG_PROJECT_ID=252702
