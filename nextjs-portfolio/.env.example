# Contact form (POST /api/contact) — set in Netlify > Site settings > Environment variables.
# Never commit real values.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "Portfolio <contact@khelifi-salmen.com>"
CONTACT_FROM_EMAIL=
# Where enquiries are delivered. Defaults to hello@khelifi-salmen.com.
CONTACT_TO_EMAIL=
# Optional: analytics
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
